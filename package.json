{
  "name": "agent-pal",
  "productName": "Agent Pal",
  "version": "1.0.0",
  "description": "AI-powered knowledge graph and question answering system",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "concurrently \"npm run watch\" \"electron --require electron-reload . --no-sandbox\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "ai",
    "knowledge-graph",
    "question-answering"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.10.6",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "node-audiorecorder": "^3.0.0"
  },
  "build": {
    "appId": "com.agentpal.app",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/PAL Transparent Logo.png",
      "darkModeSupport": true
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "index.html"
    ]
  }
}
